#!/usr/bin/env bash

set -euo pipefail

curl_config_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  printf '%s' "${value}"
}

registry_is_valid() {
  local value="$1"
  local host="${value}"
  local port=''
  local normalized_port label
  local labels=()

  if [[ "${value}" == *:* ]]; then
    [[ "${value}" != *:*:* ]] || return 1
    host="${value%:*}"
    port="${value##*:}"
    [[ "${port}" =~ ^[0-9]+$ ]] || return 1

    normalized_port="${port}"
    while [[ ${#normalized_port} -gt 1 && "${normalized_port}" == 0* ]]; do
      normalized_port="${normalized_port#0}"
    done
    [[ ${#normalized_port} -le 5 ]] || return 1
    ((10#${normalized_port} >= 1 && 10#${normalized_port} <= 65535)) || return 1
  fi

  [[ -n "${host}" && ${#host} -le 253 ]] || return 1
  [[ "${host}" =~ ^[A-Za-z0-9.-]+$ ]] || return 1
  [[ "${host}" != .* && "${host}" != *. && "${host}" != *..* ]] || return 1

  IFS='.' read -r -a labels <<< "${host}"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 ]] || return 1
    [[ "${label}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
}

cleanup() {
  unset token request_url encoded_audience
  unset ACTIONS_ID_TOKEN_REQUEST_TOKEN ACTIONS_ID_TOKEN_REQUEST_URL
}
trap cleanup EXIT

audience=''
registry=''
skopeo_auth_file=''

while (($# > 0)); do
  case "$1" in
    --audience|--registry|--skopeo-auth-file)
      (($# > 1)) || {
        printf 'image registry login: %s requires a value\n' "$1" >&2
        exit 1
      }
      case "$1" in
        --audience) audience="$2" ;;
        --registry) registry="$2" ;;
        --skopeo-auth-file) skopeo_auth_file="$2" ;;
      esac
      shift 2
      ;;
    --audience=*)
      audience="${1#--audience=}"
      shift
      ;;
    --registry=*)
      registry="${1#--registry=}"
      shift
      ;;
    --skopeo-auth-file=*)
      skopeo_auth_file="${1#--skopeo-auth-file=}"
      shift
      ;;
    *)
      printf 'image registry login: unknown argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
done

[[ -n "${audience}" ]] || {
  printf 'image registry login: --audience is required\n' >&2
  exit 1
}
[[ -n "${registry}" ]] || {
  printf 'image registry login: --registry is required\n' >&2
  exit 1
}
registry_is_valid "${registry}" || {
  printf 'image registry login: --registry must be a DNS hostname with an optional TCP port\n' >&2
  exit 1
}
[[ -n "${skopeo_auth_file}" ]] || {
  printf 'image registry login: --skopeo-auth-file is required\n' >&2
  exit 1
}
[[ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ]] || {
  printf 'image registry login: ACTIONS_ID_TOKEN_REQUEST_URL is required\n' >&2
  exit 1
}
[[ -n "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]] || {
  printf 'image registry login: ACTIONS_ID_TOKEN_REQUEST_TOKEN is required\n' >&2
  exit 1
}

encoded_audience="$(jq -rn --arg audience "${audience}" '$audience | @uri')"
separator='?'
[[ "${ACTIONS_ID_TOKEN_REQUEST_URL}" == *'?'* ]] && separator='&'
request_url="${ACTIONS_ID_TOKEN_REQUEST_URL}${separator}audience=${encoded_audience}"

token="$(
  {
    printf 'header = "Authorization: Bearer %s"\n' "$(curl_config_escape "${ACTIONS_ID_TOKEN_REQUEST_TOKEN}")"
    printf 'url = "%s"\n' "$(curl_config_escape "${request_url}")"
  } | curl --disable --fail --silent --show-error --config - \
    | jq -er '.value | select(type == "string" and length > 0)'
)"

unset ACTIONS_ID_TOKEN_REQUEST_TOKEN ACTIONS_ID_TOKEN_REQUEST_URL request_url encoded_audience
printf '::add-mask::%s\n' "${token}"
printf '%s' "${token}" | docker login "${registry}" --username oauth --password-stdin
if [[ "${registry}" == localhost:5000 || "${registry}" == 127.0.0.1:5000 ]]; then
  printf '%s' "${token}" | skopeo login --tls-verify=false --authfile "${skopeo_auth_file}" --username oauth --password-stdin "${registry}"
else
  printf '%s' "${token}" | skopeo login --authfile "${skopeo_auth_file}" --username oauth --password-stdin "${registry}"
fi

unset token
trap - EXIT
