#!/usr/bin/env python3
"""Export the platform-owned registry prefix; app inputs cannot select it."""

import os
import re
import sys

COMPONENT = re.compile(r"[a-z0-9]+(?:[._-][a-z0-9]+)*\Z")
ID = re.compile(r"[1-9][0-9]*\Z")
PUBLIC_HOST = "127.0.0.1:5000"


def contract(env, prefix):
    required = ("GITHUB_REPOSITORY_ID", "DPLATFORM", "TENANT_NAME")
    missing = [name for name in required if not env.get(name)]
    if missing:
        raise ValueError("missing platform registry configuration: " + ", ".join(missing))
    if not ID.fullmatch(env["GITHUB_REPOSITORY_ID"]):
        raise ValueError("invalid caller repository ID")
    parts = prefix.split("/")
    if len(parts) != 2 or any(len(part) > 63 or not COMPONENT.fullmatch(part) for part in parts):
        raise ValueError("invalid platform registry prefix")
    org, du = parts
    if du != env["TENANT_NAME"]:
        raise ValueError("delivery unit does not match the configured Kubernetes tenant")
    registry = PUBLIC_HOST + "/" + org + "/" + du
    return {"REGISTRY": registry, "P2P_REGISTRY": registry}


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise ValueError("expected a platform registry prefix")
        values = contract(os.environ, sys.argv[1])
        with open(os.environ["GITHUB_ENV"], "a", encoding="utf-8") as output:
            for key, value in values.items():
                output.write(f"{key}={value}\n")
    except (KeyError, OSError, ValueError) as error:
        print(f"registry contract: {error}", file=sys.stderr)
        sys.exit(1)
