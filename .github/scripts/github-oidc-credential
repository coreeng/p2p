#!/usr/bin/env bash

set -euo pipefail

curl_config_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  printf '%s' "${value}"
}

audience=''
forwarded_args=()

while (($# > 0)); do
  case "$1" in
    --audience)
      (($# > 1)) || {
        printf 'github-oidc-credential: --audience requires a value\n' >&2
        exit 1
      }
      audience="$2"
      shift 2
      ;;
    --audience=*)
      audience="${1#--audience=}"
      shift
      ;;
    *)
      forwarded_args+=("$1")
      shift
      ;;
  esac
done

[[ -n "${audience}" ]] || {
  printf 'github-oidc-credential: --audience is required\n' >&2
  exit 1
}
[[ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ]] || {
  printf 'github-oidc-credential: ACTIONS_ID_TOKEN_REQUEST_URL is required\n' >&2
  exit 1
}
[[ -n "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]] || {
  printf 'github-oidc-credential: ACTIONS_ID_TOKEN_REQUEST_TOKEN is required\n' >&2
  exit 1
}

encoded_audience="$(jq -rn --arg audience "${audience}" '$audience | @uri')"
separator='?'
[[ "${ACTIONS_ID_TOKEN_REQUEST_URL}" == *'?'* ]] && separator='&'
request_url="${ACTIONS_ID_TOKEN_REQUEST_URL}${separator}audience=${encoded_audience}"

token="$(
  {
    printf '%s\n' 'fail' 'silent' 'show-error' 'location'
    printf 'header = "Authorization: Bearer %s"\n' "$(curl_config_escape "${ACTIONS_ID_TOKEN_REQUEST_TOKEN}")"
    printf 'url = "%s"\n' "$(curl_config_escape "${request_url}")"
  } | curl --disable --config - | jq -er '.value | select(type == "string" and length > 0)'
)"

export PINNIPED_GITHUB_OIDC_TOKEN="${token}"
unset ACTIONS_ID_TOKEN_REQUEST_TOKEN ACTIONS_ID_TOKEN_REQUEST_URL
exec pinniped login static --token-env=PINNIPED_GITHUB_OIDC_TOKEN "${forwarded_args[@]}"
